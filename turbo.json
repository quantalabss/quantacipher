{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!", ".next/cache/**", "pkg/**"],
      "env": [
        "MONGODB_URI",
        "NEXTAUTH_URL",
        "NEXTAUTH_SECRET",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "RESEND_API_KEY",
        "QUANTA_API_KEY",
        "RAZORPAY_KEY_SECRET",
        "RAZORPAY_PLAN_ID_STARTUP",
        "RAZORPAY_PLAN_ID_PROFESSIONAL"
      ]
    },
    "lint": {},
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
