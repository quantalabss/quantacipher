# QuantaCipher Gateway — Environment Variables
# Copy this file to .env and fill in the values

# MongoDB URI (same cluster as quantacipher-web)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/quantacipher?retryWrites=true&w=majority

# Port (default: 4000)
PORT=4000

# Environment
NODE_ENV=development
